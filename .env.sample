DATABASE_URL=postgresql+asyncpg://user:password@db:5432/db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
PORT=8000
JWT_SECRET=secret
JWT_ALGORITHM=HS256
API_VERSION=0.1.0
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_REQUESTS=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
MIDDLEWARE_SECRET=

# Optional: only needed to actually send verification/reset emails.
# Without these, the links are still generated and logged, just not sent.
# EMAIL_SECRET and PASSWORD_RESET_SECRET fall back to JWT_SECRET if unset.
# DOMAIN=localhost:8000
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_PORT=587
# MAIL_SERVER=
# MAIL_FROM=
# MAIL_FROM_NAME=
# EMAIL_SECRET=
# PASSWORD_RESET_SECRET=

# Base URL of the SvelteKit frontend, used to build links in invite and
# proposal-notification emails. Defaults to http://localhost:5173 if unset.
# FRONTEND_URL=https://limarr.com
